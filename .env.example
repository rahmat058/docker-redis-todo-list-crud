# ==============================================================
# Root environment file used by docker-compose
# Copy to `.env` and adjust if needed:  cp .env.example .env
# ==============================================================

# ---- PostgreSQL ----
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_password
POSTGRES_DB=todo_db
# Host port mapped to the postgres container (5432)
POSTGRES_PORT=5432

# ---- Redis ----
# Host port mapped to the redis container (6379)
REDIS_PORT=6379

# ---- Backend (NestJS) ----
# Host port mapped to the backend container (3000)
BACKEND_PORT=3000

# ---- Frontend (React + Vite, served by Nginx) ----
# Host port mapped to the frontend container (80 -> served on 5173)
FRONTEND_PORT=5173
