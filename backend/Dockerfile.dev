# Development image for the NestJS API.
# Runs `nest start --watch` so the server reloads whenever source files change.
FROM node:22-bookworm-slim

WORKDIR /app

# OpenSSL is required by the Prisma query engine on slim images.
# procps provides `ps`, which `nest start --watch` uses (via tree-kill) to
# stop the previous process on reload — without it, restarts hit EADDRINUSE.
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl procps \
  && rm -rf /var/lib/apt/lists/*

# Install dependencies first so the layer is cached across source changes.
COPY package*.json ./
COPY prisma ./prisma
RUN npm install

# Generate the Prisma client against the schema.
RUN npx prisma generate

# The app source is bind-mounted at run time, but copy it as well so the image
# also works without a mount.
COPY . .

EXPOSE 3000

CMD ["npm", "run", "start:dev"]
