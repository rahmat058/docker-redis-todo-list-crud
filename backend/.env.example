# Copy to `.env` for local (non-Docker) development:  cp .env.example .env

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://todo:todo_password@localhost:5432/todo_db?schema=public"

# Redis connection string (ioredis)
REDIS_URL="redis://localhost:6379"

# CORS allowed origin ("*" or a comma separated list, e.g. http://localhost:5173)
CORS_ORIGIN="*"

# Cache TTL in seconds for list/detail Redis caching
CACHE_TTL=60
