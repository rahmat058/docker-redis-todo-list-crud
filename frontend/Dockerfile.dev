# Development image for the React + Vite app.
# Runs the Vite dev server with hot module replacement (HMR).
FROM node:22-alpine

WORKDIR /app

# Install dependencies first so the layer is cached across source changes.
COPY package*.json ./
RUN npm install

# The app source is bind-mounted at run time, but copy it as well so the image
# also works without a mount.
COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev"]
